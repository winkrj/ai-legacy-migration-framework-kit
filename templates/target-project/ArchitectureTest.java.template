    //     rule.check(classesUnderTest);
    // }
    //
    // 기존 위반이 많아 당장 통과시킬 수 없다면 baseline으로 동결한다.
    // 새로 생기는 위반만 실패하고, 고칠 때마다 baseline이 줄어든다.
    //
    //     import com.tngtech.archunit.library.freeze.FreezingArchRule;
